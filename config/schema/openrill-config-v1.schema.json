{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrill.local/schema/config/v1",
  "title": "OpenRill Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "include": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "enum": [
            "127.0.0.1",
            "::1",
            "localhost"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "modelProviders": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "apiKey": {
            "$ref": "#/$defs/secretRef"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxOutputTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "maxRetries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "readOnly": {
            "type": "boolean"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvalMode": {
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openOnStart": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key"
      ],
      "properties": {
        "kind": {
          "enum": [
            "env",
            "file",
            "os"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
