{
  "name": "@openrill/browser-playwright",
  "version": "0.25.0-step023a",
  "private": true,
  "description": "Concrete Chromium Playwright adapter for the provider-neutral OpenRill Browser Runtime.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ../../scripts/package-task.mjs clean .",
    "build": "node ../../scripts/package-task.mjs build .",
    "typecheck": "node ../../scripts/package-task.mjs typecheck ."
  },
  "dependencies": {
    "@openrill/browser-runtime": "workspace:*",
    "playwright-core": "1.62.0"
  }
}
